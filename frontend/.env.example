# Browser requests must stay on the same-origin BFF route.
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Public site origin, used for metadataBase (canonical URLs, OG image/link
# resolution) — set to the real public domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only upstream configuration. Never expose credentials through NEXT_PUBLIC_*.
BESAT_BACKEND_API_URL=http://127.0.0.1:8000/api
NEXT_SERVER_API_BASE_URL=http://127.0.0.1:8000/api

# Only set to "true" if this Next.js process is deployed behind a trusted
# reverse proxy that overwrites (not appends) x-forwarded-for before it
# reaches Next.js. Otherwise clients could spoof their IP to the backend.
BESAT_TRUST_FORWARDED_FOR=false
