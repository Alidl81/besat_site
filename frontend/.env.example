# درخواست‌های مرورگر همیشه از پراکسی هم‌دامنه‌ای فرانت عبور می‌کنند.
NEXT_PUBLIC_API_BASE_URL=/api/backend

# تنها مقدار لازم برای جابه‌جایی بین endpoint موقت و بک‌اند اصلی.
BESAT_BACKEND_API_URL=http://127.0.0.1:8000/api

# SSR در حالت موقت از Route Handler همین فرانت استفاده می‌کند.
NEXT_SERVER_API_BASE_URL=http://127.0.0.1:8000/api

# فقط صفحه About از django CMS خوانده می‌شود. در false بودن، API فعلی AboutPage استفاده می‌شود.
USE_DJANGO_CMS_ABOUT=true
DJANGO_CMS_API_BASE_URL=http://127.0.0.1:8000/api/headless-cms
DJANGO_CMS_ABOUT_LANGUAGE=fa-ir
ABOUT_FALLBACK_API_URL=http://127.0.0.1:8000/api/about/

# مسیر اختیاری فایل دیتابیس موقت؛ در حالت عادی لازم نیست.
# BESAT_MOCK_DB_PATH=/absolute/path/to/mock-database.local.json

NEXT_TELEMETRY_DISABLED=1
