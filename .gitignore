# Local backups
_backups/

# Scratch/reference workspace (venv, npm cache, stale snapshots) --
# never meant to be version-controlled; was tracked by accident.
work/

# Node dependency trees (each app has its own; this guards against an
# accidental root-level install, e.g. from running a tool in the wrong dir)
node_modules/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Django / Python cache inside backend
backend/**/__pycache__/
backend/**/*.py[cod]

# Virtual environment
backend/venv/
backend/env/
backend/.venv/
venv/
env/
.venv/

# Environment files
backend/.env
backend/.env.*
!backend/.env.example
.env
.env.*
!.env.example
docker.env
!docker.env.example

# Local agent orchestration scaffolding (worktrees for parallel sub-agents)
.claude/

# SQLite database
backend/db.sqlite3
backend/db.sqlite3-journal
*.sqlite3

# Logs
*.log

# Django collected static / uploaded media
backend/staticfiles/
backend/media/

# Test / lint / type-check cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE / Editor
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db
frontend/.env.local
frontend/.env*.local


# Local agent skills
.agents/
