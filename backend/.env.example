DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_READ_DOT_ENV_FILE=True

SECRET_KEY=change-me-for-local-development-only
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgres://besat_user:besat_password@db:5432/besat_site

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LANGUAGE_CODE=fa-ir
TIME_ZONE=Asia/Tehran

STATIC_URL=/static/
MEDIA_URL=/media/

ADMIN_URL=admin/

# Public origin of the Next.js frontend; used to build the set-password link
# sent in user-invitation emails.
FRONTEND_BASE_URL=http://localhost:3000

# Optional: leave EMAIL_HOST empty to skip SMTP delivery — invitation links
# are always also returned in the API response for the CMS UI to display.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=besat@localhost

# Optional: create/update the CMS administrator during container startup.
# Set username and password together; never commit a real password.
CMS_ADMIN_USERNAME=
CMS_ADMIN_PASSWORD=
CMS_ADMIN_EMAIL=
CMS_ADMIN_FULL_NAME=مدیر سامانه
