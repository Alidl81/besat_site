# Copy this file to .env.production (or supply the same variables via your
# deployment platform's own secret/config mechanism) and fill in the real
# values for your deployment. Never commit a real .env.production file --
# it is gitignored on purpose (see .gitignore).
#
# None of the values below are secrets in the credential sense (there is
# no API key/password here) -- they are deployment-topology values that
# differ between environments and must not silently default to a
# localhost-shaped value in production.
#
# RESOLVED LIMITATION (FE-SEO-PROD-ORIGIN-001): robots.txt and sitemap.xml
# have no request-time API of their own, so Next.js prerenders them once at
# `docker build` time by default -- before this env_file is ever applied --
# and NEXT_PUBLIC_SITE_URL is additionally webpack-inlined at that same
# build step for every other usage. Either way, a value only supplied here
# (at container start) could never reach an already-baked robots.txt/
# sitemap.xml. Those two routes now read the non-public SITE_URL below
# instead (never inlined by webpack, always read fresh from real process.env)
# and force per-request rendering, so they correctly reflect this file's
# value on every deploy without needing a Docker build ARG.
#
# RESOLVED LIMITATION (OPS-FRONTEND-BUILD-ORIGIN-001, FE-SEO-PAGE-ORIGIN-001,
# FE-SEO-NEWS-ORIGIN-001): the root layout's metadataBase and any
# statically-prerendered page's canonical/OG metadata (e.g. /about,
# /achievements, /gallery -- anything NOT forced dynamic) still bake in
# whatever NEXT_PUBLIC_SITE_URL is at `docker build` time, which the
# `env_file:` above cannot influence (that only applies once the container
# is already running). docker-compose.prod.yml's frontend.build.args now
# passes NEXT_PUBLIC_SITE_URL through as a Docker build ARG, sourced from
# your shell environment (or a .env file next to docker-compose.prod.yml)
# at `docker compose build` time -- export the SAME value you put in this
# file before building, or the image will still bake in the localhost
# fallback. shop/page.tsx, shop/[slug]/page.tsx, and news/[slug]/page.tsx
# were separately converted to build absolute canonical/OG/JSON-LD URLs via
# the runtime SITE_URL resolver instead of relying on metadataBase at all,
# so those three routes are correct even if this build ARG is forgotten;
# every other static page's metadata is not, and depends on this ARG being
# set correctly at build time.
#
# RESOLVED LIMITATION (OPS-FRONTEND-MEDIA-REWRITE-001): next.config.ts's
# `/media/*` rewrite (Django serves uploaded product/gallery/news/tour
# files there; Next has no route of its own for that path) is ALSO
# computed once, from BESAT_BACKEND_API_URL, when next.config.ts is
# evaluated during `docker build` -- the same build-time/runtime split as
# NEXT_PUBLIC_SITE_URL above. docker-compose.prod.yml's
# frontend.build.args now also passes BESAT_BACKEND_API_URL through as a
# build ARG, and frontend/Dockerfile fails the build outright if it's
# missing or resolves to loopback (127.0.0.1/localhost, which can never
# be correct from inside the frontend container -- the backend is a
# separate service, reached by its service name). Export the SAME value
# you put in this file (below) before running `docker compose build`, or
# the build will fail with a clear error instead of silently shipping an
# image where every `/media/...` request 404s.

# ---- Required ----

# The public origin end users load the site from. Must be the real
# production domain (https://), not localhost or an internal hostname.
NEXT_PUBLIC_SITE_URL=https://besat.org

# Same value as NEXT_PUBLIC_SITE_URL above, without the NEXT_PUBLIC_ prefix.
# Used only by robots.ts/sitemap.ts (FE-SEO-PROD-ORIGIN-001) so those two
# routes read the real deployment origin at request time instead of
# whatever NEXT_PUBLIC_SITE_URL happened to be during the Docker build.
SITE_URL=https://besat.org

# Where the frontend's server-side code (the BFF proxy, and next.config.ts's
# /media/* rewrite) reaches the real Django backend. Use the backend
# service's address on this compose's private network, not a public URL --
# this traffic never needs to leave the deployment's internal network.
BESAT_BACKEND_API_URL=http://backend:8000/api
NEXT_SERVER_API_BASE_URL=http://backend:8000/api

# ---- Optional (safe defaults shown -- override only if your topology differs) ----

# Same-origin path the *browser* calls; the Next.js BFF proxy at this path
# forwards to BESAT_BACKEND_API_URL server-side. This is a fixed
# same-origin path, not a per-deployment value, in every topology this
# project currently supports -- change it only if you have deliberately
# restructured the BFF proxy's own route path.
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Only set to "true" if this container sits behind a reverse proxy you
# control that you have configured to strip/overwrite any client-supplied
# X-Forwarded-For and X-Forwarded-Proto before forwarding (otherwise a
# client can spoof its own IP for anything that reads X-Forwarded-For, e.g.
# rate limiting, and can spoof X-Forwarded-Proto to make a cross-scheme BFF
# mutation request look same-origin -- SEC-FE-BFF-XFP-TRUST-001). Leave
# unset ("false") unless you have specifically verified that proxy behavior;
# with it unset, a deployment that genuinely terminates TLS in front of this
# container should expect same-origin POST/PUT/PATCH/DELETE calls through
# the BFF proxy to be rejected as cross-origin, since the origin check then
# has no way to learn the request arrived as https.
# The supplied reverse-proxy template overwrites X-Forwarded-For and
# X-Forwarded-Proto before forwarding. Keep this true only with that trust
# boundary; otherwise leave it false.
BESAT_TRUST_FORWARDED_FOR=true
