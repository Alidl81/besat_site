# Copy this file to docker.env and replace every change-me value.
#
# config.settings.production refuses to start (raises ImproperlyConfigured,
# non-zero exit, container fails its healthcheck and never comes up) if any
# "change-me"/placeholder value below is left in place, SECRET_KEY is
# missing/short, DEBUG ends up true, ALLOWED_HOSTS/CORS_ALLOWED_ORIGINS/
# CSRF_TRUSTED_ORIGINS are empty, DATABASE_URL is missing (it would
# otherwise silently fall back to a non-persistent local sqlite file --
# see config/settings/base.py), or SHOP_PAYMENT_PROVIDER is left as
# "mock" -- see backend/config/settings/_production_guard.py. This is
# intentional fail-closed behavior, not a bug: a production deployment
# that can't validate its own configuration should refuse to serve
# traffic rather than serve it insecurely (or lose data on every
# restart).
#
# Both docker-compose.prod.yml and docker-compose.backend.yml also
# hardcode DJANGO_SETTINGS_MODULE directly in their own service
# definitions (Compose's `environment:` always wins over `env_file:` for
# the same key) so this value below is redundant defense-in-depth, not
# the only thing standing between a typo here and silently booting under
# config.settings.local.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-me-use-a-long-random-secret
DEBUG=False

POSTGRES_DB=besat_site
POSTGRES_USER=besat_user
POSTGRES_PASSWORD=change-me-database-password
DATABASE_URL=postgres://besat_user:change-me-database-password@db:5432/besat_site

ALLOWED_HOSTS=localhost,127.0.0.1,backend,your-domain.example
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.example
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://your-domain.example

SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

ADMIN_URL=admin/
ENABLE_API_DOCS=False
TIME_ZONE=Asia/Tehran
LANGUAGE_CODE=fa-ir

FRONTEND_BASE_URL=https://your-domain.example

# Optional: create/update the CMS administrator during container startup.
# Set username and password together; never commit a real password.
#
# Safe to leave set across redeploys: if this admin account already
# exists, a normal restart/redeploy does NOT reset its password (an admin
# who changed their password by hand through the UI keeps it) -- only a
# first-time bootstrap (account doesn't exist yet) sets the password from
# this value. Production also refuses to bootstrap with a value that looks
# like a placeholder copied from this file. To force a real password
# reset (e.g. recovering a lost password), also set
# CMS_ADMIN_FORCE_RESET=1 for that one deploy, then unset it again.
CMS_ADMIN_USERNAME=
CMS_ADMIN_PASSWORD=
CMS_ADMIN_EMAIL=
CMS_ADMIN_FULL_NAME=مدیر سامانه
CMS_ADMIN_FORCE_RESET=

# Shop payment-provider abstraction (apps.shop.payments). "mock" is the
# only implemented provider today, and its callback endpoint is AllowAny
# by necessity (the real payment gateway calls it, not a logged-in user)
# and trusts a caller-supplied outcome=success directly -- fine for local
# development, but production refuses to start at all with
# SHOP_PAYMENT_PROVIDER=mock (see
# backend/config/settings/_production_guard.py) because anyone could mark
# their own order paid without a real payment. Register and select a real
# PaymentProvider (apps/shop/payments/registry.py) before deploying to
# production with real checkout traffic.
SHOP_PAYMENT_PROVIDER=mock

# Optional: leave EMAIL_HOST empty to skip SMTP delivery — invitation links
# are always also returned in the API response for the CMS UI to display.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=besat@your-domain.example

BACKEND_PORT=8000
PORT=8000
WEB_CONCURRENCY=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
WAIT_FOR_DATABASE=1
DATABASE_WAIT_MAX_ATTEMPTS=30
DATABASE_WAIT_DELAY_SECONDS=2
RUN_MIGRATIONS=1
COLLECT_STATIC=1
