# Non-secret Compose interpolation values used at image build time and for
# loopback host bindings. Copy to deploy/production.compose.env on the target
# host; never add the copied file to Git.
NEXT_PUBLIC_SITE_URL=https://besat.org
BESAT_BACKEND_API_URL=http://backend:8000/api
NEXT_PUBLIC_API_BASE_URL=/api/backend
BACKEND_PORT=8080
FRONTEND_PORT=3080
