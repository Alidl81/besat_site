# درخواست‌های مرورگر همیشه از پراکسی هم‌دامنه‌ای فرانت عبور می‌کنند.
NEXT_PUBLIC_API_BASE_URL=/api/backend

# تنها مقدار لازم برای جابه‌جایی بین endpoint موقت و بک‌اند اصلی.
BESAT_BACKEND_API_URL=mock://local

# SSR در حالت موقت از Route Handler همین فرانت استفاده می‌کند.
NEXT_SERVER_API_BASE_URL=http://127.0.0.1:3000/api/backend

# مسیر اختیاری فایل دیتابیس موقت؛ در حالت عادی لازم نیست.
# BESAT_MOCK_DB_PATH=/absolute/path/to/mock-database.local.json

NEXT_TELEMETRY_DISABLED=1
