# Copy to .env before running Docker Compose. Replace every change-me value.
FRONTEND_PORT=3000
BACKEND_PORT=8000

POSTGRES_DB=besat_site
POSTGRES_USER=besat_user
POSTGRES_PASSWORD=change-me-database-password
DJANGO_SECRET_KEY=change-me-use-a-long-random-secret

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Keep these disabled for local HTTP. Enable them only behind configured HTTPS.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
ENABLE_API_DOCS=False

RUN_MIGRATIONS=1
COLLECT_STATIC=1
SEED_PUBLIC_DATA=1
ENSURE_ABOUT_CMS_PAGE=1
WEB_CONCURRENCY=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
