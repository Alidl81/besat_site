# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# FE-OPS-DOCKER-CONTEXT-001: every isolated/disposable build this session
# has used its own `.next-<label>` scratch dist-dir naming convention
# (BESAT_NEXT_DIST_DIR) -- playwright, qg, qa, seo, and whatever the next
# one is called. Chasing each new convention with its own explicit
# gitignore entry keeps missing new ones (this finding is exactly that:
# .next-qa-*/.next-seo-* were never added after .next-playwright-*/
# .next-qg-* were). One glob covering the whole `.next-*` naming family
# closes this permanently instead of needing another addition next time.
/.next-*/
/.next-*.tsconfig.json
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.npm-cache/
/data/*.local.json
/playwright-report-real-django/
/test-results-real-django/
/playwright-report/
/test-results/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env
.env.*
!.env.example
!.env.production.example

.idea/
.vscode/
